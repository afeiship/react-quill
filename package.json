    "release": "pnpm --filter @jswork/react-component-library release"
  },
  "devDependencies": {
    "@jswork/next": "^1.2.2",
    "@jswork/next-replace-in-file": "^1.0.0",
    "indent-string": "^5.0.0"
  }
}
