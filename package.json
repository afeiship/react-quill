{
  "name": "@jswork/react-quill",
  "version": "1.0.0",
  "description": "React quill.",
  "homepage": "https://js.work",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter example dev",
    "docs": "node scripts/markdown.js",
    "test": "pnpm --filter @jswork/react-quill test",
    "build": "pnpm run docs && pnpm --filter @jswork/react-quill build",
    "release": "pnpm --filter @jswork/react-quill release"
  },
  "devDependencies": {
    "@jswork/next": "^1.2.2",
    "@jswork/next-replace-in-file": "^1.0.0",
    "indent-string": "^5.0.0"
  }
}
