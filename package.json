{
  "name": "@jswork/react-component-library",
  "version": "1.0.0",
  "description": "react-component-library-description",
  "homepage": "https://js.work",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter example dev",
    "docs": "node scripts/markdown.js",
