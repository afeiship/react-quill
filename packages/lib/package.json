{
  "name": "@jswork/react-quill",
  "version": "1.0.5",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "description": "React quill.",
  "homepage": "https://js.work",
  "license": "MIT",
  "sideEffects": [
    "**/*.css",
    "src/plugins/**/*"
  ],
  "files": [
    "dist",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "release": "release-it"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.2.28",
    "@types/react-dom": "^18.2.13",
    "@vitejs/plugin-react": "^6.0.1",
    "classnames": "^2.5.1",
    "jsdom": "^29.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "quill": "^2.0.3",
    "release-it": "^21.0.2",
    "tsup": "^8.2.4",
    "typescript": "^5.2.2",
    "vitest": "^4.1.2"
  },
  "peerDependencies": {
    "classnames": "*",
    "quill": "^2.0.3",
    "react": "*",
    "react-dom": "*"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
